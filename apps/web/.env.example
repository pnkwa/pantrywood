# Copy to .env.local (never commit it). Read only on the server.

# Your Grocy instance, without /api (a sub-path like https://home.example/grocy works too).
GROCY_URL=https://grocy.example.local
# Grocy → Manage API keys. Sent to Grocy as the GROCY-API-KEY header by the server proxy.
GROCY_API_KEY=

# true = use seed data instead of a real Grocy (no URL or key needed).
MOCK_GROCY=true

# Receipt scanning: a Claude API key (console.anthropic.com). Without it, mock mode returns a sample receipt.
ANTHROPIC_API_KEY=
# Receipts are read on the device by default (free, offline). Set to "claude" to send them to Claude instead.
NEXT_PUBLIC_RECEIPT_READER=
